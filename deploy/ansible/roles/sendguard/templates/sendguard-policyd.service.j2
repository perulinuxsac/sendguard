{{ ansible_managed | comment }}
[Unit]
Description=SendGuard Policy Daemon (Postfix integration)
Documentation=https://github.com/perulinux/sendguard
After=network.target sendguard-agent.service
Requires=sendguard-agent.service

[Service]
Type=simple
ExecStart={{ sendguard_bin_dir }}/sendguard-policyd -config {{ sendguard_config_dir }}/agent.yaml
Restart=always
RestartSec=5
User=root
Group=root

# El daemon es local y de bajo riesgo; no necesita namespace sandboxing
# para poder leer {{ sendguard_config_dir }}/agent.yaml sin restricciones.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sendguard-policyd

[Install]
WantedBy=multi-user.target
